---
import '../styles/global.css';
import { getBuildMeta } from '../lib/build-meta';
import { formatDateTime } from '../lib/format';

interface Props {
  title?: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const meta = getBuildMeta();
const base = import.meta.env.BASE_URL;
// 首頁以站名為 h1；事件頁的 h1 是事件標題，站名降為一般區塊。
const Brand = title ? 'div' : 'h1';
const pageTitle = title ? `${title}｜AI Trend Radar` : 'AI Trend Radar';
const path = Astro.url.pathname;
const nav = [
  { href: base, label: '總覽', current: path === base },
  { href: `${base}pricing/`, label: '價格', current: path.startsWith(`${base}pricing/`) },
  { href: `${base}decisions/`, label: '決策', current: path.startsWith(`${base}decisions/`) },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1117" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/atom+xml" title="AI Trend Radar" href={`${base}feed.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..800&display=swap" />
  </head>
  <body>
    <div class={wide ? 'wrap-wide' : 'wrap'}>
      <header class="site">
        <Brand class="brand"><a class="wordmark" href={base}>
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="14.5" />
            <circle cx="16" cy="16" r="9" />
            <path d="M16 16 L16 1.5" />
            <circle cx="22.5" cy="10" r="2.6" class="mark-dot" />
          </svg>
          <span class="name">AI Trend Radar</span>
        </a></Brand>
        <p class="tagline">模型、Coding Agent 與訂閱政策的查核後變化</p>
        <slot name="status" />
      </header>
      <nav class="site-nav" aria-label="主要導覽">
        {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
        <span class="site-nav-sub">
          <a href={`${base}feed.xml`}>訂閱 RSS／Atom</a>
          <a href={`${base}events.json`}>JSON</a>
        </span>
      </nav>
      <main>
        <slot />
      </main>
      <footer class="site" id="build-meta" data-site-built-at={meta.site_built_at}>
        <p>site_built_at：台北時間 {formatDateTime(new Date(meta.site_built_at))}</p>
        {meta.merged_at && <p>合併時間：台北時間 {formatDateTime(new Date(meta.merged_at))}</p>}
        <p>
          commit：
          {meta.commit
            ? meta.commit_url
              ? <a href={meta.commit_url}><code>{meta.commit.slice(0, 7)}</code></a>
              : <code>{meta.commit.slice(0, 7)}</code>
            : <span>本機建置（非正式部署）</span>}
        </p>
        {meta.pr_url && <p>來源 PR：<a href={meta.pr_url}>{meta.pr_url.replace('https://github.com/', '')}</a></p>}
        <p>本站只顯示合併至 main 並成功部署的內容；誰核准了什麼，以 GitHub PR 紀錄為準。</p>
      </footer>
    </div>
  </body>
</html>
