---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ImportanceBadge from '../../components/ImportanceBadge.astro';
import { importanceMap } from '../../lib/importance';
import { getDecisions, relatedOf } from '../../lib/events';
import { getPricing, usd } from '../../lib/pricing';
import {
  CATEGORY_LABEL,
  IMPACT_LABEL,
  SOURCE_TYPE_LABEL,
  STATUS_LABEL,
  VENDOR_LABEL,
  formatDate,
  formatDateTime,
  formatMonthDay,
} from '../../lib/format';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const d = event.data;
const { Content } = await render(event);
const corrections = (await getCollection('corrections')).filter((c) => c.data.event_id === event.id);
// 重要度的新近度以「全部事件中最新的事件日」為基準，所以要拿整個 collection 算。
const allEvents = await getCollection('events');
const imp = importanceMap(allEvents).get(event.id)!;
const related = relatedOf(event, allEvents);
const decisions = (await getDecisions()).filter((x) => x.data.related_events.includes(event.id));
const prices = (await getPricing()).filter((x) => x.data.related_events.includes(event.id));
const DECISION_STATUS: Record<string, string> = { approved: '已核准', candidate: '候選（待核准）', retired: '已退役' };
const p = imp.parts;
const signed = (n: number) => (n < 0 ? `−${-n}` : `+${n}`);
---
<Base title={d.title}>
  <nav class="crumb" aria-label="頁面導覽"><a href={import.meta.env.BASE_URL}>← 回首頁</a></nav>

  <article class="event">
    <!-- 標頭卡：與首頁事件卡共用 .ev-tags / .badge / .imp 視覺語彙 -->
    <header class={`card event-head cat-${d.category}`} data-importance={imp.level}>
      <div class="ev-tags">
        <ImportanceBadge imp={imp} showScore />
        <span class={`badge ${d.status}`}>{STATUS_LABEL[d.status]}</span>
        <span class="badge cat">{CATEGORY_LABEL[d.category]}</span>
        {d.vendors.map((v) => <a class="badge vendor" href={`${import.meta.env.BASE_URL}vendors/${v}/`}>{VENDOR_LABEL[v]}</a>)}
        {d.example && <span class="badge example">範例資料</span>}
      </div>
      <h1>{d.title}</h1>
      <dl class="facts">
        <div>
          <dt>事件時間</dt>
          <dd>
            {d.date_unknown
              ? '日期未知（無可靠發生日期）'
              : <>台北時間 <time datetime={d.event_at.toISOString()}>{formatDateTime(d.event_at)}</time></>}
          </dd>
        </div>
        <div>
          <dt>查核時間</dt>
          <dd>台北時間 <time datetime={d.verified_at.toISOString()}>{formatDateTime(d.verified_at)}</time></dd>
        </div>
        <div>
          <dt>來源類型</dt>
          <dd>{SOURCE_TYPE_LABEL[d.source_type]}</dd>
        </div>
        <div>
          <dt>影響程度</dt>
          <dd><span class={`badge impact-${d.impact}`}>{IMPACT_LABEL[d.impact]}</span></dd>
        </div>
      </dl>
      <div class="imp-break" aria-label="重要度組成">
        <span class="k">重要度 {imp.score} 分</span>
        <span>影響 {signed(p.impact)}</span>
        <span>排名 {signed(p.editorial)}</span>
        {p.featured > 0 && <span>精選 {signed(p.featured)}</span>}
        <span>新近度 {signed(p.recency)}</span>
        {p.confidence < 0 && <span class="neg">可信度 {signed(p.confidence)}</span>}
      </div>
      <p class="fact-line"><span class="label">已查核事實</span>{d.summary}</p>
      <p class="infer-line"><span class="tag-infer">推論</span>{d.impact_summary.replace(/^推論[:：]\s*/, '')}</p>
    </header>

    <section aria-labelledby="h-sources">
      <h2 id="h-sources">原始來源</h2>
      <ul class="sources">
        {d.sources.map((s) => (
          <li class="card">
            <a class="source-title" href={s.url} rel="noopener noreferrer">{s.title}</a>
            <div class="meta">
              {s.publisher && <span>{s.publisher}</span>}
              <span class="source-url">{s.url}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="card prose" aria-label="事件內文">
      <Content />
    </section>

    {prices.length > 0 && (
      <section aria-labelledby="h-price">
        <h2 id="h-price">目前官方定價</h2>
        <div class="card price-box">
          {prices.map((x) => (
            <p>
              <a href={`${import.meta.env.BASE_URL}pricing/#${x.id}`}><b>{x.data.name}</b></a>：
              輸入 {usd(x.data.input)}・快取命中 {usd(x.data.cached_input)}・輸出 {usd(x.data.output)}（USD／每百萬 token）
            </p>
          ))}
          <p class="side-meta">取自官方定價頁，查核於 {formatDate(prices[0].data.verified_at)}；可能與事件發生當時的價格不同。</p>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section aria-labelledby="h-related">
        <h2 id="h-related">相關事件</h2>
        <ol class="card related">
          {related.map(({ event: r, direction }) => (
            <li class={`cat-${r.data.category}`}>
              <time datetime={r.data.event_at.toISOString()}>{r.data.date_unknown ? '日期未知' : formatMonthDay(r.data.event_at)}</time>
              <span class="rel-dir">{{ later: '後續', same: '同日', earlier: '先前' }[direction]}</span>
              <a href={`${import.meta.env.BASE_URL}events/${r.id}/`}>{r.data.title}</a>
            </li>
          ))}
        </ol>
        <p class="side-meta">關聯為編輯判斷（同系列、同類功能或被引用），不代表因果關係。</p>
      </section>
    )}

    {decisions.length > 0 && (
      <section aria-labelledby="h-decisions">
        <h2 id="h-decisions">相關決策</h2>
        {decisions.map((x) => (
          <div class="card">
            <div class="ev-tags"><span class={`badge decision-${x.data.status}`}>{DECISION_STATUS[x.data.status]}</span></div>
            <p><a href={`${import.meta.env.BASE_URL}decisions/#${x.id}`}>{x.data.title}</a></p>
          </div>
        ))}
      </section>
    )}

    {d.next_check && (
      <section aria-labelledby="h-next">
        <h2 id="h-next">下次需核對</h2>
        <div class="card">
          <div class="ev-tags">
            <span class="badge unverified">待查</span>
            {d.next_check_at && (
              <time class="due" datetime={d.next_check_at.toISOString()} data-due={d.next_check_at.toISOString()}>
                {formatDate(d.next_check_at)} 到期
              </time>
            )}
          </div>
          <p>{d.next_check}</p>
        </div>
      </section>
    )}

    {corrections.length > 0 && (
      <section aria-labelledby="h-corrections">
        <h2 id="h-corrections">修正紀錄</h2>
        {corrections.map((c) => (
          <div class="card">
            <div class="ev-tags"><span class="badge corrected">已更正</span></div>
            <p><span class="label">原說法</span>{c.data.previous_claim}</p>
            <p><span class="label">更正為</span>{c.data.corrected_claim}</p>
            <p><span class="label">緣由</span>{c.data.reason}</p>
            <div class="meta"><span>更正於台北時間 {formatDateTime(c.data.corrected_at)}</span></div>
          </div>
        ))}
      </section>
    )}
  </article>
</Base>

<script>
  // 是否已到期要在閱讀當下判斷（靜態建置時間不等於閱讀時間）。
  document.querySelectorAll<HTMLElement>('[data-due]').forEach((el) => {
    if (new Date(el.dataset.due!).getTime() <= Date.now()) {
      el.classList.add('is-overdue');
      el.textContent = `${el.textContent!.trim().replace(/ 到期$/, '')} 已到期`;
    }
  });
</script>
