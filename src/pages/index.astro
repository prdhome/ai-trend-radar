---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents, latestVerifiedAt, pendingChecks, weeklyHighlights } from '../lib/events';
import { getBuildMeta } from '../lib/build-meta';
import { STALE_HOURS, formatDate, formatDateTime } from '../lib/format';

const events = await getEvents();
const weekly = weeklyHighlights(events);
const pending = pendingChecks(events);
const lastVerified = latestVerifiedAt(events);
const meta = getBuildMeta();
const builtAt = new Date(meta.site_built_at);
const hasExamples = events.some((e) => e.data.example);

const eventTitles = new Map(events.map((e) => [e.id, e.data.title]));
const corrections = (await getCollection('corrections'))
  .sort((a, b) => b.data.corrected_at.getTime() - a.data.corrected_at.getTime())
  .slice(0, 5);
const base = import.meta.env.BASE_URL;
---
<Base wide>
  {hasExamples && (
    <p class="notice">目前顯示的是<strong>格式範例資料</strong>（內容純屬虛構），不是真實新聞。</p>
  )}

  <!-- 1. 版本狀態列 -->
  <section class="statusbar" aria-label="版本狀態"
    id="status" data-last-verified={lastVerified?.toISOString() ?? ''} data-stale-hours={STALE_HOURS}>
    <p>資料查核至：{lastVerified ? `台北時間 ${formatDateTime(lastVerified)}` : '尚無資料'}</p>
    <p>網站發布於：台北時間 {formatDateTime(builtAt)}</p>
    {events.length === 0 && <p>本次查核無新項目。</p>}
    <p class="stale" id="stale-warning" hidden>資料可能過期：超過 {STALE_HOURS} 小時沒有內容更新。</p>
  </section>

  <!-- 2. 本週重點（v0.2 §6.2：content/events 中 weekly_rank 不為 null，依數字排序） -->
  <section aria-labelledby="h-weekly">
    <h2 id="h-weekly">本週重點</h2>
    {weekly.length === 0
      ? <p class="empty">本週尚未選出重點。</p>
      : <div class="weekly-grid">{weekly.map((e) => <EventCard event={e} showRank />)}</div>}
  </section>

  <!-- 3. 分類與搜尋 -->
  <section aria-labelledby="h-all">
    <h2 id="h-all">分類與搜尋</h2>
    <div class="filters">
      <div class="chips" role="group" aria-label="分類">
        <button type="button" data-cat="all" aria-pressed="true">全部</button>
        <button type="button" data-cat="model" aria-pressed="false">模型</button>
        <button type="button" data-cat="agent" aria-pressed="false">Agent</button>
        <button type="button" data-cat="pricing" aria-pressed="false">價格政策</button>
      </div>
      <div class="row">
        <input type="search" id="q" placeholder="關鍵字搜尋" aria-label="關鍵字搜尋" />
        <select id="sort" aria-label="排序">
          <option value="event">依事件日期</option>
          <option value="verified">最近更新</option>
        </select>
      </div>
    </div>
    <div id="event-list">
      {events.map((e) => (
        <div
          class="event-item"
          data-category={e.data.category}
          data-event={e.data.event_at.getTime()}
          data-verified={e.data.verified_at.getTime()}
          data-text={`${e.data.title} ${e.data.summary} ${e.data.impact_summary}`.toLowerCase()}
        >
          <EventCard event={e} />
        </div>
      ))}
    </div>
    <p class="empty" id="no-match" hidden>沒有符合條件的事件。</p>
  </section>

  <!-- 4. 近期修正 -->
  <section aria-labelledby="h-corrections">
    <h2 id="h-corrections">近期修正</h2>
    {corrections.length === 0
      ? <p class="empty">目前沒有修正紀錄。</p>
      : corrections.map((c) => (
          <article class="card">
            <div class="badges"><span class="badge corrected">已更正</span></div>
            <h3>
              <a href={`${base}events/${c.data.event_id}/`}>{eventTitles.get(c.data.event_id) ?? c.data.event_id}</a>
            </h3>
            <p><span class="label">原說法</span>{c.data.previous_claim}</p>
            <p><span class="label">更正為</span>{c.data.corrected_claim}</p>
            <p><span class="label">緣由</span>{c.data.reason}</p>
            <div class="meta">
              <span>更正於 {formatDate(c.data.corrected_at)}</span>
              <span>新來源：<a href={c.data.sources[0].url} rel="noopener noreferrer">{c.data.sources[0].title}</a></span>
            </div>
          </article>
        ))}
  </section>

  <!-- 5. 待查事項（最多 3 項，明確標「未驗證」） -->
  <section aria-labelledby="h-pending">
    <h2 id="h-pending">待查事項</h2>
    {pending.length === 0
      ? <p class="empty">目前沒有待查事項。</p>
      : pending.map((e) => (
          <article class="card">
            <div class="badges">
              <span class="badge unverified">未驗證</span>
              {e.data.example && <span class="badge example">範例資料</span>}
            </div>
            <h3><a href={`${base}events/${e.id}/`}>{e.data.title}</a></h3>
            {e.data.next_check && <p><span class="label">下一步</span>{e.data.next_check}</p>}
          </article>
        ))}
  </section>
</Base>

<script>
  // 過期判斷必須在「閱讀當下」算，靜態建置時間無法代表使用者打開頁面的時間。
  const status = document.getElementById('status');
  const last = status?.dataset.lastVerified;
  const hours = Number(status?.dataset.staleHours ?? 48);
  if (last && Date.now() - new Date(last).getTime() > hours * 3600 * 1000) {
    document.getElementById('stale-warning')?.removeAttribute('hidden');
    status?.classList.add('is-stale');
  }

  const list = document.getElementById('event-list')!;
  const items = Array.from(list.querySelectorAll<HTMLElement>('.event-item'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chips button'));
  const q = document.getElementById('q') as HTMLInputElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const noMatch = document.getElementById('no-match')!;
  let cat = 'all';

  function apply() {
    const term = q.value.trim().toLowerCase();
    const key = sort.value === 'verified' ? 'verified' : 'event';
    items
      .sort((a, b) => Number(b.dataset[key]) - Number(a.dataset[key]))
      .forEach((el) => list.appendChild(el));
    let shown = 0;
    for (const el of items) {
      const ok = (cat === 'all' || el.dataset.category === cat) && (!term || el.dataset.text!.includes(term));
      el.hidden = !ok;
      if (ok) shown++;
    }
    noMatch.hidden = shown > 0;
  }

  chips.forEach((b) =>
    b.addEventListener('click', () => {
      cat = b.dataset.cat ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
      apply();
    }),
  );
  q.addEventListener('input', apply);
  sort.addEventListener('change', apply);
</script>
