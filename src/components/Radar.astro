---
/**
 * 首頁雷達：四個扇區＝分類，同心環＝週次（越靠中心越新）。
 * 環從「最新事件所在週」往外數，不用建置時間，也不寫「本週／上週」：靜態建置時間不等於閱讀時間。
 * 角度依序號平均分布（不用亂數），重新建置時光點位置不會跳動。
 */
import type { EventEntry, WeekGroup } from '../lib/events';
import { CATEGORY_LABEL, STATUS_LABEL, formatDate } from '../lib/format';
import { CATEGORIES } from '../content/config';

interface Props {
  events: EventEntry[];
  weeks: WeekGroup[];
}
const { events, weeks } = Astro.props;
const base = import.meta.env.BASE_URL;

const MAX_RINGS = 4;
const C = 200;
const R_HUB = 26;
const R_MAX = 168;

// 第 4 環以外的舊週全部折進最外環（標成「更早」）。
const ringWeeks = weeks.slice(0, MAX_RINGS);
const folded = weeks.length > MAX_RINGS;
const unknown = events.filter((e) => e.data.date_unknown);
const ringCount = Math.max(ringWeeks.length, 1) + (unknown.length > 0 ? 1 : 0);
const step = (R_MAX - R_HUB) / ringCount;

const rings = ringWeeks.map((w, i) => ({
  r: R_HUB + step * (i + 1),
  label: folded && i === MAX_RINGS - 1 ? `${w.label} 及更早` : w.label,
}));
if (unknown.length > 0) rings.push({ r: R_MAX, label: '日期未知' });

const ringOf = (e: EventEntry) => {
  if (e.data.date_unknown) return ringCount - 1;
  const i = ringWeeks.findIndex((w) => w.events.includes(e));
  return i === -1 ? Math.min(weeks.length, MAX_RINGS) - 1 : i;
};

// 扇區從正上方順時針：模型、Agent、價格政策、待觀察訊號。
const sectorOf = (cat: string) => CATEGORIES.indexOf(cat as (typeof CATEGORIES)[number]);

const buckets = new Map<string, EventEntry[]>();
for (const e of events) {
  const key = `${sectorOf(e.data.category)}:${ringOf(e)}`;
  if (!buckets.has(key)) buckets.set(key, []);
  buckets.get(key)!.push(e);
}

const blips = [...buckets.entries()].flatMap(([key, list]) => {
  const [s, ring] = key.split(':').map(Number);
  return list.map((e, j) => {
    // 扇區兩側各留 12° 給軸線與環標籤。
    const deg = s * 90 + 12 + (66 * (j + 1)) / (list.length + 1);
    // 同一格內輪流內外錯開，避免光點排成一條弧線互相擠壓。
    const r = R_HUB + step * ring + step * (0.32 + 0.36 * ((j % 3) / 2));
    const rad = (deg * Math.PI) / 180;
    return {
      e,
      x: +(C + r * Math.sin(rad)).toFixed(1),
      y: +(C - r * Math.cos(rad)).toFixed(1),
    };
  });
});

const counts = Object.fromEntries(CATEGORIES.map((c) => [c, events.filter((e) => e.data.category === c).length]));
const corners: Record<string, { x: number; y: number; anchor: string }> = {
  model: { x: 392, y: 22, anchor: 'end' },
  agent: { x: 392, y: 388, anchor: 'end' },
  pricing: { x: 8, y: 388, anchor: 'start' },
  signal: { x: 8, y: 22, anchor: 'start' },
};
---
<figure class="radar" aria-labelledby="radar-cap">
  <div class="radar-scope">
    <svg viewBox="0 0 400 400" role="group" aria-label="事件雷達：依分類與週次分布的事件，可點選光點開啟事件">
      <defs>
        <linearGradient id="sweep-grad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="var(--scope-glow)" stop-opacity="0" />
          <stop offset="1" stop-color="var(--scope-glow)" stop-opacity=".28" />
        </linearGradient>
      </defs>
      <circle cx={C} cy={C} r={R_MAX + 14} class="scope-disc" />
      <g class="sweep" aria-hidden="true">
        <path d={`M${C} ${C} L${C} ${C - R_MAX - 14} A${R_MAX + 14} ${R_MAX + 14} 0 0 0 ${(C - (R_MAX + 14) * Math.sin(Math.PI / 4)).toFixed(1)} ${(C - (R_MAX + 14) * Math.cos(Math.PI / 4)).toFixed(1)} Z`} fill="url(#sweep-grad)" />
      </g>
      <g class="grid" aria-hidden="true">
        {rings.map((ring, i) => (
          <circle cx={C} cy={C} r={ring.r} class={i === rings.length - 1 && unknown.length > 0 ? 'ring unknown' : 'ring'} />
        ))}
        <circle cx={C} cy={C} r={R_HUB} class="ring hub" />
        <line x1={C} y1={C - R_MAX - 14} x2={C} y2={C + R_MAX + 14} />
        <line x1={C - R_MAX - 14} y1={C} x2={C + R_MAX + 14} y2={C} />
      </g>
      <g class="ring-labels" aria-hidden="true">
        {rings.map((ring, i) => (
          <text x={C} y={C + ring.r} text-anchor="middle" dominant-baseline="middle">{ring.label}</text>
        ))}
      </g>
      <g class="sector-labels" aria-hidden="true">
        {CATEGORIES.map((c) => (
          <text x={corners[c].x} y={corners[c].y} text-anchor={corners[c].anchor} class={counts[c] === 0 ? 'is-empty' : ''}>
            {CATEGORY_LABEL[c]}<tspan dx="6" class="n">{counts[c] === 0 ? '尚無' : counts[c]}</tspan>
          </text>
        ))}
      </g>
      <g class="blips">
        {blips.map(({ e, x, y }) => (
          <a
            href={`${base}events/${e.id}/`}
            class={`blip cat-${e.data.category} st-${e.data.status}`}
            aria-label={`${e.data.title}（${CATEGORY_LABEL[e.data.category]}，${STATUS_LABEL[e.data.status]}）`}
            data-title={e.data.title}
            data-meta={`${e.data.date_unknown ? '日期未知' : formatDate(e.data.event_at)}・${CATEGORY_LABEL[e.data.category]}・${STATUS_LABEL[e.data.status]}`}
          >
            <circle cx={x} cy={y} r="16" class="hit" />
            <circle cx={x} cy={y} r={e.data.weekly_rank !== null ? 7.5 : 6} class="dot" />
          </a>
        ))}
      </g>
    </svg>
    <div class="radar-tip" role="tooltip" hidden><strong></strong><span></span></div>
  </div>
  <figcaption id="radar-cap">
    <ul class="legend" aria-label="圖例">
      {CATEGORIES.map((c) => <li><i class={`swatch cat-${c}`}></i>{CATEGORY_LABEL[c]}</li>)}
    </ul>
    <ul class="legend legend-status" aria-label="光點樣式">
      <li><i class="shape solid"></i>官方已確認</li>
      <li><i class="shape ring"></i>第三方報導</li>
      <li><i class="shape dashed"></i>未驗證</li>
      <li><i class="shape big"></i>大點＝本週重點</li>
    </ul>
    <p>越靠中心越新；每一環是一週（台北時間週一至週日），環上標的是該環涵蓋的日期。</p>
  </figcaption>
</figure>

<script>
  const scope = document.querySelector<HTMLElement>('.radar-scope');
  const tip = scope?.querySelector<HTMLElement>('.radar-tip');
  if (scope && tip) {
    const show = (a: SVGAElement) => {
      const dot = a.querySelector('.dot')!.getBoundingClientRect();
      const box = scope.getBoundingClientRect();
      tip.querySelector('strong')!.textContent = a.dataset.title ?? '';
      tip.querySelector('span')!.textContent = a.dataset.meta ?? '';
      tip.hidden = false;
      const x = dot.left + dot.width / 2 - box.left;
      const w = tip.offsetWidth;
      tip.style.left = `${Math.min(Math.max(x - w / 2, 4), box.width - w - 4)}px`;
      const above = dot.top - box.top - tip.offsetHeight - 10;
      tip.style.top = `${above < 4 ? dot.bottom - box.top + 10 : above}px`;
    };
    const hide = () => (tip.hidden = true);
    scope.querySelectorAll<SVGAElement>('.blip').forEach((a) => {
      a.addEventListener('pointerenter', () => show(a));
      a.addEventListener('pointerleave', hide);
      a.addEventListener('focus', () => show(a));
      a.addEventListener('blur', hide);
    });
  }
</script>
