---
/**
 * 重要度 × 類別矩陣＋圖例。列總計即重要度分布。格子明暗＝事件數，格內一律寫數字。
 * 圖例只講公式重點；完整權重在 <details> 內（與 lib/importance.ts 的註解同一份規則）。
 */
import type { EventEntry } from '../lib/events';
import { IMPORTANCE_LABEL, IMPORTANCE_LEVELS, IMPORTANCE_THRESHOLD, type Importance } from '../lib/importance';
import ImportanceBadge from './ImportanceBadge.astro';
import { CATEGORY_LABEL } from '../lib/format';
import { CATEGORIES } from '../content/config';

interface Props {
  events: EventEntry[];
  imp: Map<string, Importance>;
}
const { events, imp } = Astro.props;
const cell = (lv: string, c: string) => events.filter((e) => imp.get(e.id)!.level === lv && e.data.category === c).length;
const rowTotal = (lv: string) => events.filter((e) => imp.get(e.id)!.level === lv).length;
const max = Math.max(1, ...IMPORTANCE_LEVELS.flatMap((lv) => CATEGORIES.map((c) => cell(lv, c))));
const sample = (lv: (typeof IMPORTANCE_LEVELS)[number]): Importance => ({
  score: IMPORTANCE_THRESHOLD[lv],
  level: lv,
  rank: (IMPORTANCE_LEVELS.indexOf(lv) + 1) as Importance['rank'],
  label: IMPORTANCE_LABEL[lv],
  parts: { impact: 0, editorial: 0, featured: 0, recency: 0, confidence: 0 },
});
const range = (lv: (typeof IMPORTANCE_LEVELS)[number]) => {
  const i = IMPORTANCE_LEVELS.indexOf(lv);
  const hi = i === 0 ? 100 : IMPORTANCE_THRESHOLD[IMPORTANCE_LEVELS[i - 1]] - 1;
  return `${IMPORTANCE_THRESHOLD[lv]}–${hi}`;
};
---
<div class="imp-panel">
  <div class="matrix-wrap">
    <table class="matrix">
      <caption class="sr-only">重要度 × 類別事件數</caption>
      <thead>
        <tr>
          <th scope="col"><span class="sr-only">重要度</span></th>
          {CATEGORIES.map((c) => <th scope="col" class={`cat-${c}`}><i class="swatch" aria-hidden="true"></i><span>{CATEGORY_LABEL[c]}</span></th>)}
          <th scope="col">合計</th>
        </tr>
      </thead>
      <tbody>
        {IMPORTANCE_LEVELS.map((lv) => (
          <tr>
            <th scope="row"><ImportanceBadge imp={sample(lv)} /></th>
            {CATEGORIES.map((c) => {
              const n = cell(lv, c);
              return <td class={n === 0 ? 'is-zero' : n / max >= 0.55 ? 'is-dark' : ''} style={`--a:${(n / max).toFixed(2)}`}>{n}</td>;
            })}
            <td class="total">{rowTotal(lv)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="imp-legend">
    <p class="imp-formula">
      <b>分數 0–100</b>＝影響程度＋本週排名＋精選＋新近度<span class="minus">−可信度扣分</span>
    </p>
    <ul class="imp-levels">
      {IMPORTANCE_LEVELS.map((lv) => <li><span class={`lv lv-${lv}`}>{lv.toUpperCase()}</span>{IMPORTANCE_LABEL[lv]} <small>{range(lv)} 分</small></li>)}
    </ul>
    <details class="imp-details">
      <summary>分數怎麼算</summary>
      <dl>
        <div><dt>影響程度</dt><dd>需要行動 40・值得評估 28・持續觀察 16・無影響 4</dd></div>
        <div><dt>本週排名</dt><dd>第 1 名 30，每降一名 −4；未入選 0</dd></div>
        <div><dt>精選</dt><dd>+10</dd></div>
        <div><dt>新近度</dt><dd>與資料中最新事件日同日 20，每舊 1 天 −2，最低 0</dd></div>
        <div><dt>可信度</dt><dd>官方已確認 0・第三方報導 −6・已更正 −8・未驗證 −12</dd></div>
      </dl>
      <p>重要度是排序用的推導訊號，不是查核結論；事件是否屬實請看狀態徽章。</p>
    </details>
  </div>
</div>
